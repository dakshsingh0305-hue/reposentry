# RepoSentry Environment Variables
# Copy this file to .env.local and fill in your values

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://reposentry.vercel.app
NEXT_PUBLIC_SITE_NAME=RepoSentry

# GitHub (optional) - for API access limits
GITHUB_TOKEN=your_github_token_here  # optional, increases rate limit

# OSV.dev API - free tier, no key required
# https://osv.dev/docs/getting-started/search-api/

# AI Explanations (optional) - powered by Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here  # optional, disable with empty value
GEMINI_MODEL=gemini-2.0-flash-exp  # or gemini-1.5-flash

# Vercel / Analytics (optional)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
NEXT_PUBLIC_GA_ID=